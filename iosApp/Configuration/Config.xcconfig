TEAM_ID=

PRODUCT_NAME=NoteMark
PRODUCT_BUNDLE_IDENTIFIER=dev.havlicektomas.notemark.NoteMark$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// SharedLogic is a static framework; SQLDelight's native driver (SQLiter)
// needs the system SQLite at link time.
OTHER_LDFLAGS=$(inherited) -lsqlite3