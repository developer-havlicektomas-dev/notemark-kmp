<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (cloud backup and device-to-device transfer). See backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="notemark_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="notemark_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
